{
  "name": "fwqgo",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun run build:web && bun run build:cms && bun run prepare:standalone && bun run verify:apps",
    "build:web": "next build apps/web --turbopack",
    "build:cms": "next build apps/cms --turbopack",
    "prepare:standalone": "bun scripts/prepare-standalone-runtime.mjs",
    "check": "bun run verify:repository && bun run verify:public-mobile-ui && bun run verify:cms-mobile-ui && bun run verify:table-mobile-labels && bun run verify:ai-rewrite-prompts && bun run lint && bun run typecheck && bun run test && bun run verify:article-seo-links && bun run verify:article-markdown && bun run verify:architecture && bun run verify:deploy && bun run verify:migrations && bun run verify:knowledge && bun run verify:knowledge-content && bun run verify:knowledge-decision && bun run verify:server-sizing && bun run verify:inventory-filters && bun run verify:network-experience && bun run verify:security && bun run verify:security-runtime && bun run verify:article-workflow && bun run verify:dependencies && bun run verify:cache && bun run verify:public-seo",
    "deploy:local": "bash scripts/deploy-local-build.sh",
    "healthcheck:prod": "bash scripts/production-healthcheck.sh",
    "verify:apps": "bun scripts/verify-app-boundaries.mjs",
    "verify:public-mobile-ui": "bun scripts/verify-public-mobile-ui.ts",
    "verify:cms-mobile-ui": "bun scripts/verify-cms-mobile-ui.ts",
    "verify:table-mobile-labels": "bun scripts/verify-table-mobile-labels.tsx",
    "verify:ai-rewrite-prompts": "bun scripts/verify-ai-rewrite-prompts.ts",
    "verify:article-workflow": "bun test ./scripts/verify-manual-article-workflow.test.ts",
    "verify:repository": "bun scripts/verify-repository-hygiene.mjs",
    "verify:architecture": "bun scripts/verify-architecture.mjs",
    "verify:deploy": "bun scripts/verify-deploy-workflow.mjs",
    "verify:runtime-config": "bun scripts/verify-runtime-config.mjs",
    "verify:migrations": "bun scripts/verify-migrations.mjs",
    "verify:knowledge": "bun scripts/verify-knowledge-bilingual.mjs",
    "verify:knowledge-content": "bun scripts/verify-knowledge-content.ts && bun scripts/verify-knowledge-revision.ts",
    "verify:knowledge-decision": "bun scripts/verify-knowledge-decision-coverage.ts",
    "verify:server-sizing": "bun scripts/verify-server-sizing.ts",
    "verify:inventory-filters": "bun test ./scripts/verify-inventory-filters.tsx",
    "verify:network-experience": "bun scripts/verify-network-experience.ts",
    "verify:article-seo-links": "bun scripts/verify-article-seo-links.ts",
    "smoke:knowledge-migration": "bun scripts/smoke-knowledge-migration.mjs",
    "smoke:security-migrations": "bun scripts/smoke-security-migrations.mjs",
    "verify:security": "bun scripts/verify-security-boundaries.ts",
    "verify:security-runtime": "bun test ./scripts/verify-security-runtime.test.ts ./scripts/verify-audit-regressions.test.ts",
    "verify:cache": "bun scripts/verify-public-cache-boundaries.ts && bun run verify:knowledge-performance && bun run verify:article-navigation",
    "verify:knowledge-performance": "bun scripts/verify-knowledge-performance.ts",
    "verify:knowledge-nginx": "bun scripts/verify-knowledge-nginx.mjs",
    "verify:nginx-transport": "bun scripts/verify-nginx-transport.ts",
    "smoke:knowledge": "bun scripts/smoke-knowledge-performance.mjs",
    "audit:performance": "bun scripts/audit-public-performance.mjs",
    "smoke:built": "bun test ./scripts/verify-prerendered-article-metadata.mjs && bun scripts/smoke-built-apps.mjs",
    "smoke:article-isr": "bun scripts/verify-production-article.mjs",
    "smoke:mobile": "bun scripts/smoke-mobile.mjs",
    "smoke:cms": "bun scripts/smoke-cms-browser.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "bun scripts/migrate-prod.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "links:convert": "bun scripts/convert-post-links-to-short-slugs.ts",
    "knowledge:publish-initial": "bun scripts/publish-initial-bilingual-knowledge.ts",
    "posts:backfill-en-taxonomy": "bun scripts/backfill-english-taxonomy.ts",
    "posts:backfill-internal-links": "bun scripts/backfill-post-internal-links.ts",
    "posts:regenerate-provider-deals": "bun scripts/regenerate-provider-deal-drafts.ts",
    "offers:backfill-whmcs-prices": "bun scripts/backfill-whmcs-offer-prices.ts",
    "secrets:migrate": "bun scripts/migrate-secrets.ts",
    "source:pull": "bun --conditions=react-server scripts/pull-source-site-to-ai-drafts.ts",
    "dev": "bun run dev:web",
    "dev:web": "next dev apps/web --turbopack -p 3000",
    "dev:cms": "next dev apps/cms --turbopack -p 3100",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "bun run build && bun run start:web",
    "start": "bun run start:web",
    "start:web": "next start apps/web -p 3000",
    "start:cms": "next start apps/cms -p 3100",
    "test": "bun --no-env-file scripts/run-local-tests.mjs",
    "typecheck": "tsc --noEmit",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "verify:public-seo": "bun scripts/verify-public-seo.ts",
    "smoke:public-seo": "bun scripts/smoke-public-seo.mjs",
    "audit:public-seo": "bun scripts/audit-public-seo-data.ts",
    "verify:article-markdown": "bun test ./scripts/verify-article-markdown.ts",
    "verify:article-navigation": "SKIP_ENV_VALIDATION=1 bun test ./scripts/verify-article-navigation.ts",
    "verify:dependencies": "bun audit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@next/env": "^16.3.5",
    "@radix-ui/react-alert-dialog": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-icons": "^1.3.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-navigation-menu": "^1.2.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@t3-oss/env-nextjs": "^0.13.11",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "domhandler": "5.0.3",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "marked": "18.0.11",
    "next": "^16.3.5",
    "postgres": "^3.4.7",
    "puppeteer": "^25.0.4",
    "re2js": "2.8.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.76.0",
    "server-only": "0.0.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "undici": "7.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.23",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "esbuild": "0.28.1",
    "undici": "7.29.0"
  }
}
